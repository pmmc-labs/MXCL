(let ^ESC ("\e" ~ (91 .chr)))

(let ^BOLD      1)
(let ^FAINT     2)
(let ^ITALIC    3)
(let ^UNDERLINE 4)
(let ^INVERT    7)
(let ^HIDE      8)
(let ^STRIKE    9)

(define Style (fg-color bg-color $styles)
    (make-opaque (make-role
        (let $fg-color (fg-color .unshift (list 38 2)))
        (let $bg-color (bg-color .unshift (list 48 2)))

        (define .render (_ cell) (do
            (join "" (list ^ESC
                (($styles .push
                    (($fg-color .push
                        ($bg-color ->list)) ->list))
                    .join ";") ";m"
                (cell .render)
                ^ESC "0m"))
        ))
    ))
)

(let ^LEFT   -1)
(let ^CENTER  0)
(let ^RIGHT   1)

(define Cell ($content $width $align $padding)
    (make-opaque (make-role
        (define .render (_) (do
            (let len ($content .length))
            (if ($width == len)
                $content
            (if ($width < len)
                ($content .substr 0 $width)
            (if ($width > len) (do
                (let pad ($padding .repeat ($width - len)))
                (if ($align == ^LEFT)
                    ($content ~ pad)
                (if ($align == ^RIGHT)
                    (pad ~ $content)
                (if ($align == ^CENTER) (do
                    (let w (($width - len) / 2))
                    (let lhs ($padding .repeat (w .ceil)))
                    (let rhs ($padding .repeat (w .floor)))
                    (lhs ~ ($content ~ rhs))
                )())))
            )())))
        ))
    ))
)

(let s1 (Style (^PANTONE .at :armyGreen) (^PANTONE .at :artichoke) +[ ^ITALIC ]))
(let c1 (Cell "hello world" 20 ^CENTER "."))

(let s2 (Style (^PANTONE .at :sapphireBlue) (^PANTONE .at :neonCarrot) +[ ^BOLD ]))
(let c2 (Cell "Goodbye!" 20 ^CENTER "."))

(say (s1 .render c1))
(say (s2 .render c2))
(say (s2 .render c1))
(say (s1 .render c2))






