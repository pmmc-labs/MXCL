
(define hex->rgb ($hex)
    +[
        (($hex .substr 0 2) .hex)
        (($hex .substr 2 2) .hex)
        (($hex .substr 4 2) .hex)
    ]
)

(define rgb->hex ($rgb)
    +[
        (($rgb .at 0) .hex)
        (($rgb .at 1) .hex)
        (($rgb .at 2) .hex)
    ]
)

